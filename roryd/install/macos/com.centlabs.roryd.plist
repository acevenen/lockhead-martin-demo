<?xml version="1.0" encoding="UTF-8"?>
<!--
    LaunchAgent for the RORY daemon on macOS (MacBook Air M2).

    A LaunchAgent (not a LaunchDaemon) runs in the logged-in user's GUI
    session, which is what lets it reach the microphone and trigger the TCC
    consent prompt. RunAtLoad starts it at login; KeepAlive restarts it if it
    crashes.

    Install:
      cp com.centlabs.roryd.plist ~/Library/LaunchAgents/
      # edit the two REPLACE_ME paths below first
      launchctl load ~/Library/LaunchAgents/com.centlabs.roryd.plist

    The FIRST run pops a microphone-permission prompt — approve it, or the wake
    word never fires. If it was denied: System Settings > Privacy & Security >
    Microphone, enable the terminal/Python entry, then `launchctl kickstart`.

    Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.centlabs.roryd.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.centlabs.roryd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>roryd.daemon</string>
    </array>

    <!-- REPLACE_ME: absolute path to the repo's roryd/ directory -->
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME/centlabs/lockhead-martin-demo/roryd</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>.</string>
        <!-- REPLACE_ME: absolute path to the repo root -->
        <key>RORY_HOME</key>
        <string>/Users/REPLACE_ME/centlabs/lockhead-martin-demo</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/roryd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/roryd.err.log</string>
</dict>
</plist>
