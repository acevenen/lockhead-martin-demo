# CentLabs Node 001 — copy to `.env` and fill in. NEVER commit the real .env.
# `make up` reads this. Secrets live here on the machine and nowhere else.

# Postgres (the memory system's source of truth)
POSTGRES_USER=centlabs
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=memory

# Qdrant vector store — protect it even on the LAN
QDRANT_API_KEY=change-me-to-a-long-random-string

# The hostname Caddy serves on (MagicDNS name or a tailnet name).
# The glasses web app and the MacBook reach the stack at https://$NODE_HOST
NODE_HOST=node001

# ---- Not used by compose, but the rest of CentLabs reads these -----------
# Set in your shell / the daemon's environment, never in the repo:
#   ANTHROPIC_API_KEY=...      # Hermes routes long-form reasoning to Claude
#   ELEVENLABS_API_KEY=...     # JARVIS cinematic voice
#   JARVIS_WOL_TOKEN=...       # voice power-on bridge auth
