{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event",
  "type": "object",
  "required": [
    "id",
    "type",
    "actor",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "subject_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
