{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lesson",
  "type": "object",
  "required": [
    "id",
    "trigger_conditions",
    "prevention_instruction",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "trigger_conditions": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prevention_instruction": {
      "type": "string"
    },
    "enforcement_mechanism": {
      "type": [
        "string",
        "null"
      ]
    },
    "regression_check": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "stated",
        "inferred",
        "uncertain"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "superseded",
        "ineffective"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
