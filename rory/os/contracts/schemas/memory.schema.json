{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory",
  "type": "object",
  "required": [
    "id",
    "type",
    "subject",
    "content",
    "status",
    "source_type",
    "created_by",
    "created_at",
    "sensitivity"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "goal",
        "constraint",
        "decision",
        "project_state",
        "procedure",
        "lesson",
        "relationship",
        "capability",
        "temporary_context"
      ]
    },
    "scope": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "disputed",
        "superseded",
        "expired",
        "rejected"
      ]
    },
    "source_type": {
      "type": "string"
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "stated",
        "inferred",
        "uncertain"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
