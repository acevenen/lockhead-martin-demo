{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact",
  "type": "object",
  "required": [
    "id",
    "task_id",
    "type",
    "authoring_agent",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "path_or_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string"
    },
    "authoring_agent": {
      "type": "string"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "unreviewed",
        "approved",
        "changes_requested"
      ]
    },
    "verification": {
      "type": "object"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "retention": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
