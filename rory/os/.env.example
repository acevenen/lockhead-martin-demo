# Rory OS — environment variable NAMES only. Copy to `.env` and fill in on the
# machine. NEVER commit a real .env. NEVER put secret values in the repo.
# The core (tests, demo, board) needs NONE of these — they're for connecting
# real models later.

# Operational DB location (optional; defaults to rory/data/rory.db)
# RORY_DB_PATH=/absolute/path/to/rory.db

# Log level: debug|info|warn|error (optional)
# RORY_LOG_LEVEL=info

# ---- Model ids per profile (resolved at runtime; NOT hardcoded in code) -------
# Set the concrete model id for each profile you actually use.
# RORY_MODEL_CEO=
# RORY_MODEL_REASONING=
# RORY_MODEL_CODING=
# RORY_MODEL_CODE_REVIEW=
# RORY_MODEL_FAST=
# RORY_MODEL_RESEARCH=
# RORY_MODEL_VISION=
# RORY_MODEL_EMBED=
# RORY_MODEL_LOCAL=

# ---- Provider credentials (set in the shell/env, referenced by name only) -----
# Real provider adapters FAIL CLOSED until these exist. Never reuse Claude Code's
# interactive credentials as an application key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RORY_OLLAMA_URL=http://127.0.0.1:11434
